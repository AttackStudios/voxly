{
  "name": "voxly",
  "productName": "Voxly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Voxly — invite-only chat: servers, DMs, group chats, voice/video, screen share, remote control.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "admin": "node server/admin.js",
    "electron": "electron .",
    "electron:open": "open node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "app": "bash scripts/run-mac.sh",
    "app:terminal": "concurrently -k \"npm:server\" \"npm:dev\" \"npm:electron\"",
    "stack": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build:win": "bash scripts/build-win.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.0",
    "redux": "^5.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "eslint": "^9.39.1",
    "vite": "^7.2.4"
  }
}
